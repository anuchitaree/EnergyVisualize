<Window x:Class="EnergyVisualize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnergyVisualize"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="133*" />
            <ColumnDefinition Width="466*" />
        </Grid.ColumnDefinitions>

        <Button Click="Button_Click" Content="Click Me" Width="100" Height="30"
                Grid.Row="0" Grid.Column="0"  />
       
        <ScottPlot:WpfPlot x:Name="EnergyPlot"
                        Grid.Column="0" 
                        Grid.Row ="1" 
                        Grid.ColumnSpan="2" />

        <ScottPlot:WpfPlot x:Name="EnergyPlot2"
                Grid.Column="0" 
                Grid.Row ="2" 
                Grid.ColumnSpan="2" />
        
        
    </Grid>
</Window>
