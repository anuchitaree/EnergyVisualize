<Window x:Class="EnergyVisualize.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnergyVisualize.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Window.DataContext>
        <vm:MainViewModel xmlns:vm="clr-namespace:EnergyVisualize.ViewModels"/>
    </Window.DataContext>
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button Content="Usage Energy" 
             Width="100"
             Height="30"
             Command="{Binding ShowUsageEnergyCommand}"/>
            <Button Content="Summary Energy" 
             Width="100" 
             Height="30" 
             Command="{Binding ShowPowerPeakCommand}"/>
        </StackPanel>
        <ContentControl Content="{Binding CurrentView}"
                 Background="Aqua"/>
    </DockPanel>
</Window>
