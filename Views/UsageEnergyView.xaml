<UserControl x:Class="EnergyVisualize.Views.UsageEnergyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:EnergyVisualize.Views"
             xmlns:vm="clr-namespace:EnergyVisualize.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
   
    
    <Grid Background="LightGreen">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"> </RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Left"
                    Orientation="Horizontal">

            <CheckBox Content="Monday"
                      Tag="A"
                      Margin="10,5,5,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction
                            Command="{Binding CheckChangeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource
                            self }}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="UnChecked">
                        <i:InvokeCommandAction
                            Command="{Binding CheckChangeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource
                             self}}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </CheckBox>
            <CheckBox Content="Tuesday"
                      Tag="B"
                      Margin="5">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction
                            Command="{Binding CheckChangeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="UnChecked">
                        <i:InvokeCommandAction
                            Command="{Binding CheckChangeCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                       
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </CheckBox>



            <CheckBox Content="Tuesday" 
                      Checked="CheckBox_Checked"
                      CommandParameter="2"
                      Margin="5"/>
            
            <CheckBox 
                      CommandParameter="3"
                      Margin="5">
                <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:InvokeCommandAction
                         Command="{Binding CheckCommand}"
                        ></i:InvokeCommandAction>
                </i:EventTrigger>
                </i:Interaction.Triggers>
            </CheckBox>
            
            <CheckBox Content="Thursday" 
                      Command="{Binding CheckCommand}"
                      CommandParameter="4"
                      Margin="5"/>
            <CheckBox Content="Friday" 
                      Command="{Binding CheckCommand}"
                      CommandParameter="5"
                      Margin="5"/>
            <CheckBox Content="Saturday" 
                      Command="{Binding CheckCommand}"
                      CommandParameter="6"
                      Margin="5"/>  
            <CheckBox Content="Sunday" 
                      Command="{Binding CheckCommand}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                      Margin="5"/>
            <Label Content ="Focus week:"/>
            <DatePicker />
            <Button Width="60" Height="30" Content="Submit"> </Button>

        </StackPanel>
    </Grid>
</UserControl>
